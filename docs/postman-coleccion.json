{
  "info": {
    "name": "Lista de tareas API",
    "description": "Pruebas manuales de la API desplegada. Cambia la variable baseUrl por tu dominio de Vercel. El flujo principal se ejecuta en orden; el folder Errores se puede correr después.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://TU-API.vercel.app"
    },
    {
      "key": "email",
      "value": "prueba@example.com"
    },
    {
      "key": "password",
      "value": "ClaveSegura123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "uid",
      "value": ""
    },
    {
      "key": "tareaId",
      "value": ""
    },
    {
      "key": "createdAt",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Flujo principal",
      "item": [
        {
          "name": "01 · Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/health"
          },
          "description": "No toca Firebase. Solo comprueba que el deployment sirve las rutas.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok true\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "02 · Registro",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Genera un correo único. Ejecutar antes del resto del flujo.",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"email\", \"prueba+\" + Date.now() + \"@example.com\");"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"201 Created\", () => pm.response.to.have.status(201));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", b.token);",
                  "pm.collectionVariables.set(\"refreshToken\", b.refreshToken);",
                  "pm.collectionVariables.set(\"uid\", b.usuario.id);",
                  "pm.test(\"devuelve usuario\", () => pm.expect(b.usuario.email).to.eql(pm.collectionVariables.get(\"email\")));",
                  "pm.test(\"expiraEnSeg numérico\", () => pm.expect(b.expiraEnSeg).to.be.a(\"number\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "03 · Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", b.token);",
                  "pm.collectionVariables.set(\"refreshToken\", b.refreshToken);",
                  "pm.collectionVariables.set(\"uid\", b.usuario.id);",
                  "pm.test(\"misma forma que registro\", () => pm.expect(b.usuario.email).to.eql(pm.collectionVariables.get(\"email\")));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "04 · Refresh",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"token\", b.token);",
                  "pm.collectionVariables.set(\"refreshToken\", b.refreshToken);",
                  "pm.test(\"sin usuario\", () => pm.expect(b).to.not.have.property(\"usuario\"));",
                  "pm.test(\"expiraEnSeg numérico\", () => pm.expect(b.expiraEnSeg).to.be.a(\"number\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "05 · Perfil",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/auth/yo"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"mismo uid\", () => pm.expect(b.usuario.id).to.eql(pm.collectionVariables.get(\"uid\")));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "06 · Crear tarea",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tareas/{{tareaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Prueba desde Postman\",\n  \"descripcion\": \"Tarea de prueba\",\n  \"prioridad\": 2,\n  \"vence_en\": \"2026-12-01T15:00:00.000Z\",\n  \"completada\": false\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "pm.collectionVariables.set(\"tareaId\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ],
                "type": "text/javascript"
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.collectionVariables.set(\"createdAt\", b.created_at);",
                  "pm.test(\"id correcto\", () => pm.expect(b.id).to.eql(pm.collectionVariables.get(\"tareaId\")));",
                  "pm.test(\"no borrada\", () => pm.expect(b.deleted_at).to.eql(null));",
                  "pm.test(\"sin notificacion_id\", () => pm.expect(b).to.not.have.property(\"notificacion_id\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "07 · Listar tareas",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/tareas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"incluye la tarea\", () => pm.expect(b.items.some((t) => t.id === pm.collectionVariables.get(\"tareaId\"))).to.eql(true));",
                  "pm.test(\"servidor_ahora\", () => pm.expect(b.servidor_ahora).to.be.a(\"string\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "08 · Listar con since",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/tareas?since=2026-11-01T00:00:00.000Z"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "09 · Editar y completar",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tareas/{{tareaId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Prueba editada\",\n  \"descripcion\": null,\n  \"prioridad\": 1,\n  \"vence_en\": \"2026-12-02T15:00:00.000Z\",\n  \"completada\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "pm.test(\"conserva created_at\", () => pm.expect(b.created_at).to.eql(pm.collectionVariables.get(\"createdAt\")));",
                  "pm.test(\"completada\", () => pm.expect(b.completada).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "10 · Eliminar",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/tareas/{{tareaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok true\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "11 · Listar después de borrar",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/tareas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "const b = pm.response.json();",
                  "const t = b.items.find((x) => x.id === pm.collectionVariables.get(\"tareaId\"));",
                  "pm.test(\"sigue en la lista\", () => pm.expect(t).to.be.an(\"object\"));",
                  "pm.test(\"borrado lógico\", () => pm.expect(t.deleted_at).to.be.a(\"string\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "12 · Eliminar de nuevo (idempotente)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/tareas/{{tareaId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"200 OK\", () => pm.response.to.have.status(200));",
                  "pm.test(\"ok true\", () => pm.expect(pm.response.json().ok).to.eql(true));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Errores",
      "item": [
        {
          "name": "E1 · GET sin token",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/api/tareas"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"mismo mensaje\", () => pm.expect(pm.response.json().error).to.eql(\"No autorizado\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E2 · PUT inválido",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/tareas/00000000-0000-0000-0000-000000000001",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"ab\",\n  \"prioridad\": 9\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"400\", () => pm.response.to.have.status(400));",
                  "const b = pm.response.json();",
                  "pm.test(\"detalles\", () => pm.expect(b.detalles).to.be.an(\"array\"));",
                  "pm.test(\"campos titulo y prioridad\", () => {",
                  "  const campos = b.detalles.map((d) => d.campo);",
                  "  pm.expect(campos).to.include(\"titulo\");",
                  "  pm.expect(campos).to.include(\"prioridad\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E3 · Registro duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/registro",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "description": "Ejecutar después del registro principal, para que el correo exista.",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"409\", () => pm.response.to.have.status(409));",
                  "pm.test(\"mensaje\", () => pm.expect(pm.response.json().error).to.eql(\"El correo ya está registrado\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E4 · Login correo inexistente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"no-existe+{{$timestamp}}@example.com\",\n  \"password\": \"ClaveSegura123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"mensaje genérico\", () => pm.expect(pm.response.json().error).to.eql(\"Credenciales inválidas\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E5 · Login contraseña incorrecta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"ClaveIncorrecta123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"mismo mensaje que correo inexistente\", () => pm.expect(pm.response.json().error).to.eql(\"Credenciales inválidas\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E6 · Refresh inválido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"token-invalido\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"401\", () => pm.response.to.have.status(401));",
                  "pm.test(\"sesión expirada\", () => pm.expect(pm.response.json().error).to.eql(\"Sesión expirada\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "E7 · DELETE inexistente",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "url": "{{baseUrl}}/api/tareas/00000000-0000-0000-0000-000000000002"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"404\", () => pm.response.to.have.status(404));",
                  "pm.test(\"no encontrado\", () => pm.expect(pm.response.json().error).to.eql(\"No encontrado\"));"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    }
  ]
}
